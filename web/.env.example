# ============================================================================
# CONFIGURAÇÃO DO BLOQUINHO DIGITAL
# ============================================================================
# Este arquivo documenta todas as variáveis de ambiente necessárias.
# Copie para .env.local e preencha com seus valores reais.
# 
# ⚠️ NUNCA commite .env.local com valores reais!
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# SUPABASE (Principal - Banco de Dados e Auth)
# ────────────────────────────────────────────────────────────────────────────
# Obtenha em: https://supabase.com/dashboard/project/SEU_PROJETO/settings/api

VITE_SUPABASE_URL=https://nhrzaeteadlzvgqfqzkr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Provider de banco de dados (supabase ou firebase)
VITE_DB_PROVIDER=supabase

# ────────────────────────────────────────────────────────────────────────────
# FIREBASE (Apenas para Hosting - opcional)
# ────────────────────────────────────────────────────────────────────────────
# Obtenha em: https://console.firebase.google.com/project/SEU_PROJETO/settings/general

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ────────────────────────────────────────────────────────────────────────────
# TABELAS DO SUPABASE (Opcional - valores padrão)
# ────────────────────────────────────────────────────────────────────────────
# Normalmente não precisa alterar

VITE_SUPABASE_TABLE_PROFILES=users_profiles
VITE_SUPABASE_TABLE_CUSTOMERS=customers
VITE_SUPABASE_TABLE_INVENTORY=inventory_items
VITE_SUPABASE_TABLE_SALES=sales
VITE_SUPABASE_TABLE_RECEIVABLES=receivables
VITE_SUPABASE_TABLE_MOVEMENTS=inventory_movements

# ────────────────────────────────────────────────────────────────────────────
# IMPORTANTE
# ────────────────────────────────────────────────────────────────────────────
# 1. Copie este arquivo para .env.local
# 2. Preencha VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY
# 3. NUNCA commite .env.local
# 4. Para mais detalhes, veja: CONFIGURAR_SUPABASE.md
