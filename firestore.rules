rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Protege campos "server-controlled" contra update via front-end.
    function unchanged(field) {
      return !(field in request.resource.data) ||
        (resource != null && request.resource.data[field] == resource.data[field]);
    }

    // Catálogo global (futuro): somente leitura.
    match /catalogs/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Dados do usuário: todas as coleções ficam sob /users/{uid}/...
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !('growthLevel' in request.resource.data);
      allow update: if isOwner(uid) && unchanged('growthLevel');
      allow delete: if false;

      // Subcoleções do usuário (customers, products, inventory, sales, receivables, payments, ...)
      match /{collectionId}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}

