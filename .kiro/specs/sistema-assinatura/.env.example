# ⚠️ NUNCA COMPARTILHE ESTE ARQUIVO COM AS CREDENCIAIS REAIS!
# Este é apenas um exemplo. Crie um arquivo .env com suas credenciais reais.

# Credenciais de TESTE do Mercado Pago (para desenvolvimento)
MERCADOPAGO_ACCESS_TOKEN_TEST=TEST-xxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MERCADOPAGO_PUBLIC_KEY_TEST=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Credenciais de PRODUÇÃO do Mercado Pago (para uso real)
# ⚠️ NUNCA commite estas credenciais no Git!
# ⚠️ NUNCA compartilhe publicamente!
MERCADOPAGO_ACCESS_TOKEN_PROD=APP_USR-xxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
MERCADOPAGO_PUBLIC_KEY_PROD=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Como usar no Firebase Functions:
# firebase functions:config:set mercadopago.access_token="SUA_CREDENCIAL_AQUI"
# firebase functions:config:set mercadopago.public_key="SUA_CREDENCIAL_AQUI"
