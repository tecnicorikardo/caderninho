# Mercado Pago Credentials
# IMPORTANTE: Estas são credenciais de EXEMPLO. Você deve substituir pelos seus próprios valores.
# NUNCA commite o arquivo .env com credenciais reais!

# Access Token do Mercado Pago (obtido no painel do Mercado Pago)
# Exemplo: APP_USR-5103858731893876-030411-92514761f8a098ef418a525724240068-466908277
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXXXX-XXXXXX-XXXXXXXX-XXXXXXXX

# Public Key do Mercado Pago (usado no frontend)
# Exemplo: APP_USR-abc96f3b-22e4-4032-aee6-b5f6e286b27c
MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Client Secret do Mercado Pago (usado para validar webhooks)
# Exemplo: 3u8B8HQwEPzOiOcUnZ3ciDNkXZxrfU3p
MERCADOPAGO_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL base da aplicação (para URLs de retorno de pagamento)
# Produção: https://bloquinhodigital.web.app
# Desenvolvimento: http://localhost:5000
APP_BASE_URL=https://bloquinhodigital.web.app

# URL das Firebase Functions (para webhooks)
# Produção: https://southamerica-east1-bloquinhodigital.cloudfunctions.net
# Desenvolvimento: http://localhost:5001/bloquinhodigital/southamerica-east1
FUNCTIONS_URL=https://southamerica-east1-bloquinhodigital.cloudfunctions.net

